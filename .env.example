# AutoVulnScan - Environment Variables
# ======================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it is listed in .gitignore.
#
# VULNCHECK_TOKEN
#   Bearer token for VulnCheck NVD++ — used as CVE fallback when CIRCL
#   returns no results.  Obtain a free token at: https://vulncheck.com/token
#
VULNCHECK_TOKEN=vulncheck_your_token_here

# NVD_API_KEY (legacy alias — also accepted as the VulnCheck token)
# NVD_API_KEY=your_key_here
